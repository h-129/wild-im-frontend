{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    // 允许合成默认导入
    "allowSyntheticDefaultImports": true,
    // 开启 ES 模块和 CommonJS 的互操作性
    "esModuleInterop": true,
    // 配置基础路径
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
